{
  "appId": "app.logbook.gym",
  "appName": "Logbook",
  "webDir": "dist",
  "backgroundColor": "#0b0c0d",
  "android": {
    "backgroundColor": "#0b0c0d",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
